y = 1,
total_samples = c(min(pie_data$total_samples), median(pie_data$total_samples), max(pie_data$total_samples))
)
# Create a pie chart grob for each site
create_pie_grob <- function(data_row) {
pie_data <- data.frame(
sample_type = c("faecal", "rectal_swab", "nasal_swab", "tissue"),
proportion = c(data_row$faecal, data_row$rectal_swab, data_row$nasal_swab,
data_row$tissue)
)
pie_data <- pie_data[pie_data$proportion > 0, ]  # Remove zeros
pie <- ggplot(pie_data, aes(x = "", y = proportion, fill = sample_type)) +
geom_bar(stat = "identity", width = 1) +
coord_polar(theta = "y") +
scale_fill_manual(values = sample_colors) +
theme_void() +
theme(legend.position = "none")
ggplotGrob(pie)
}
# Get map data for Australia
australia_map_data <- ne_countries(scale = "medium", country = "Australia", returnclass = "sf")
australia_states <- ne_states(country = "Australia", returnclass = "sf")
# Base plot
main_plot <- ggplot() +
geom_sf(data = australia_map_data, fill = "grey95", color = "black") +
geom_sf(data = australia_states, fill = NA, color = "black", linetype = "dotted") +
# Add labels for each site
geom_text_repel(data = pie_data,
aes(x = long, y = lat, label = site),
size = 3, box.padding = 0.5, max.overlaps = Inf) +
coord_sf(xlim = c(110, 155), ylim = c(-45, -10), expand = FALSE) +
theme_void() +
theme(
panel.background = element_rect(fill = "white"),
plot.background = element_rect(fill = "white", color = NA),
panel.border = element_blank()
)
# Add pie charts to the base plot
for (i in 1:nrow(pie_data)) {
pie_grob <- create_pie_grob(pie_data[i, ])
radius <- sqrt(pie_data$total_samples[i]) / 8  # Scale pies
main_plot <- main_plot +
annotation_custom(
pie_grob,
xmin = pie_data$long[i] - radius, xmax = pie_data$long[i] + radius,
ymin = pie_data$lat[i] - radius, ymax = pie_data$lat[i] + radius
)
}
# Add color legend
main_plot <- main_plot +
geom_point(data = dummy_data, aes(x = x, y = y, fill = sample_type), shape = 21, size = 5) +
scale_fill_manual(values = sample_colors, name = "Sample Type")
# Add size legend
main_plot <- main_plot +
geom_point(data = size_legend_data, aes(x = x, y = y, size = sqrt(total_samples) / 8), fill = "grey50", shape = 21) +
scale_size_continuous(
name = "Number of Samples",
breaks = sqrt(size_legend_data$total_samples) / 8,  # Use the same scaling formula for the legend
labels = size_legend_data$total_samples
)
# Display the combined plot
print(main_plot)
ggsave(plot = main_plot, filename = "~/Documents/GitHub/phd/p2_dogs/4_figures/map.svg", height = 12, width = 12, limitsize = FALSE, dpi = 1000)
library(tidyverse)
library(geosphere)
library(dplyr)
library(ggplot2)
library(readxl)
library(vegan)
library(tidyr)
library(tibble)
setwd("/Users/jonmifsud/Documents/GitHub/phd/p2_dogs/virus_evolution_revisions/analyses/data/")
# Read in BLAST identity data
# There are some differences in metadata so we need to do a little bit of cleaning
identity_data_raw <- read.table("all_virus_nucleotide_sequence_identity.txt", header = FALSE,
col.names = c("seq1", "seq2", "sequence_identity")) %>%
mutate(renamed_seq1 = case_when(str_detect(seq1, "_pr_") ~ str_replace(seq1, "_pr_", "_perth_"),
str_detect(seq1, "_ch_") ~ str_replace(seq1, "_ch_", "_coffsharbour_"),
str_detect(seq1, "_il_") ~ str_replace(seq1, "_il_", "_illawarra_"),
str_detect(seq1, "_hp_") ~ str_replace(seq1, "_hp_", "_hopevale_"),
str_detect(seq1, "_hv_") ~ str_replace(seq1, "_hv_", "_huntervalley_"),
str_detect(seq1, "_cw_") ~ str_replace(seq1, "_cw_", "_centralwest_"),
str_detect(seq1, "_mld_") ~ str_replace(seq1, "_mld_", "_myalllakedingo_"),
TRUE ~ as.character(.$seq1)),
renamed_seq2 = case_when(str_detect(seq2, "_pr_") ~ str_replace(seq2, "_pr_", "_perth_"),
str_detect(seq2, "_ch_") ~ str_replace(seq2, "_ch_", "_coffsharbour_"),
str_detect(seq2, "_il_") ~ str_replace(seq2, "_il_", "_illawarra_"),
str_detect(seq2, "_hp_") ~ str_replace(seq2, "_hp_", "_hopevale_"),
str_detect(seq2, "_hv_") ~ str_replace(seq2, "_hv_", "_huntervalley_"),
str_detect(seq2, "_cw_") ~ str_replace(seq2, "_cw_", "_centralwest_"),
str_detect(seq2, "_mld_") ~ str_replace(seq2, "_mld_", "_myalllakedingo_"),
TRUE ~ as.character(.$seq2))) %>%
mutate(renamed_seq1 = case_when(renamed_seq1 == "canine_astrovirus_centralwest_5" ~ "canine_astrovirus_centralwest_5_capsid",
renamed_seq1 == "canine_astrovirus_centralwest_6" ~ "canine_astrovirus_centralwest_6_capsid_RdRp",
renamed_seq1 == "canine_astrovirus_huntervalley_3" ~ "canine_astrovirus_huntervalley_3_capsid_RdRp",
renamed_seq1 == "canine_astrovirus_huntervalley_6" ~ "canine_astrovirus_huntervalley_6_capsid_RdRp",
renamed_seq1 == "canine_astrovirus_huntervalley_7" ~ "canine_astrovirus_huntervalley_7_capsid_RdRp",
renamed_seq1 == "canine_astrovirus_perth_6" ~ "canine_astrovirus_perth_6_capsid_RdRp",
renamed_seq1 == "canine_picodicistrovirus_coffsharbour_4" ~ "canine_picodicistrovirus_coffsharbour_5",
renamed_seq1 == "canine_picornavirus_0_coffsharbour_4_RdRp" ~ "canine_picornavirus_coffsharbour_4_RdRp" ,
renamed_seq1 == "canine_picornavirus_1_coffsharbour_4_start" ~ "canine_picornavirus_coffsharbour_4_start",
renamed_seq1 == "canine_respiratory_coronavirus_hv6_NSP8" ~ "canine_respiratory_coronavirus_huntervalley_6_NSP8",
renamed_seq1 == "canine_respiratory_coronavirus_hv6_RdRp" ~ "canine_respiratory_coronavirus_huntervalley_6_RdRp",
renamed_seq1 == "rotavirus_A_myalllakedingo_NSP1" ~ "rotavirus_A_myalllakedingo_4_NSP1",
renamed_seq1 == "rotavirus_A_myalllakedingo_NSP3" ~ "rotavirus_A_myalllakedingo_4_NSP3",
renamed_seq1 == "rotavirus_A_myalllakedingo_VP1" ~ "rotavirus_A_myalllakedingo_4_VP1",
renamed_seq1 == "ucalufa_virus_hopevale_19_polymerase" ~ "ucalufa_virus_hopevale_19_polymerase_a",
renamed_seq1 == "ucalufa_virus_hopevale_19_VP1" ~ "ucalufa_virus_hopevale_19_polymerase_b",
TRUE ~ as.character(.$renamed_seq1)),
renamed_seq2 = case_when(renamed_seq2 == "canine_astrovirus_centralwest_5" ~ "canine_astrovirus_centralwest_5_capsid",
renamed_seq2 == "canine_astrovirus_centralwest_6" ~ "canine_astrovirus_centralwest_6_capsid_RdRp",
renamed_seq2 == "canine_astrovirus_huntervalley_3" ~ "canine_astrovirus_huntervalley_3_capsid_RdRp",
renamed_seq2 == "canine_astrovirus_huntervalley_6" ~ "canine_astrovirus_huntervalley_6_capsid_RdRp",
renamed_seq2 == "canine_astrovirus_huntervalley_7" ~ "canine_astrovirus_huntervalley_7_capsid_RdRp",
renamed_seq2 == "canine_astrovirus_perth_6" ~ "canine_astrovirus_perth_6_capsid_RdRp",
renamed_seq2 == "canine_picodicistrovirus_coffsharbour_4" ~ "canine_picodicistrovirus_coffsharbour_5",
renamed_seq2 == "canine_picornavirus_0_coffsharbour_4_RdRp" ~ "canine_picornavirus_coffsharbour_4_RdRp" ,
renamed_seq2 == "canine_picornavirus_1_coffsharbour_4_start" ~ "canine_picornavirus_coffsharbour_4_start",
renamed_seq2 == "canine_respiratory_coronavirus_hv6_NSP8" ~ "canine_respiratory_coronavirus_huntervalley_6_NSP8",
renamed_seq2 == "canine_respiratory_coronavirus_hv6_RdRp" ~ "canine_respiratory_coronavirus_huntervalley_6_RdRp",
renamed_seq2 == "rotavirus_A_myalllakedingo_NSP1" ~ "rotavirus_A_myalllakedingo_4_NSP1",
renamed_seq2 == "rotavirus_A_myalllakedingo_NSP3" ~ "rotavirus_A_myalllakedingo_4_NSP3",
renamed_seq2 == "rotavirus_A_myalllakedingo_VP1" ~ "rotavirus_A_myalllakedingo_4_VP1",
renamed_seq2 == "ucalufa_virus_hopevale_19_polymerase" ~ "ucalufa_virus_hopevale_19_polymerase_a",
renamed_seq2 == "ucalufa_virus_hopevale_19_VP1" ~ "ucalufa_virus_hopevale_19_polymerase_b",
TRUE ~ as.character(.$renamed_seq2)))
# Load the metadata
virus_metadata <- read_xlsx("Supplementary_Table_5.xlsx") %>%
mutate(join_column = word(library, sep = "_")) %>%
mutate(virus_species = case_when(virus_species == "canine_calicivirus_like" ~ "canine_calicivirus",
TRUE ~ as.character(.$virus_species)))
geo_metadata <- read_csv("sampling_geo_data.csv")
# Merge virus and geo metadata
metadata_joint_virus_geo <- virus_metadata %>%
left_join(geo_metadata, by = c("join_column" = "id")) %>%
select(virus_name, location, library, virus_species, site, lat, long)
# Join the identity data with metadata for both sequences
identity_data <- identity_data_raw %>%
left_join(metadata_joint_virus_geo, by = c("renamed_seq1" = "virus_name")) %>%
rename(lat1 = lat, lon1 = long, location1 = location, site1 = site,
virus_species1 = virus_species, library1 = library) %>%
left_join(metadata_joint_virus_geo, by = c("renamed_seq2" = "virus_name")) %>%
rename(lat2 = lat, lon2 = long, location2 = location, site2 = site,
virus_species2 = virus_species, library2 = library)
# Calculate the geographic distance between each pair of sequences
identity_data$geographical_distance <- distHaversine(
cbind(identity_data$lon1, identity_data$lat1),
cbind(identity_data$lon2, identity_data$lat2)
) / 1000  # Convert meters to kilometers
# Subset the dataset to include only RdRp containing fragments and segments as efforts were made to
# recover these for every library so they are the best protein to compare across sequences.
rdrp_containing_sequences <- read.delim("rdrp_containing_sequences", header = FALSE)
identity_data <- identity_data %>%
filter(seq1 %in% rdrp_containing_sequences$V1) %>%
filter(seq2 %in% rdrp_containing_sequences$V1)
# Filter for within-species comparisons, exclude self-hits
identity_data_clean <- identity_data %>%
filter(virus_species1 == virus_species2) %>%
filter(seq1 != seq2) %>%
distinct(seq1, seq2, .keep_all = TRUE) %>%
# handy to get ordered seq1 seq2 so that A-B pairs can be compared.
mutate(seq_min = pmin(seq1, seq2),
seq_max = pmax(seq1, seq2))
# Get a list of unique species for the loop
species_list <- unique(identity_data_clean$virus_species1)
# Mantel test results df
mantel_results <- data.frame(
species = character(),
mantel_r = numeric(),
mantel_p_value = numeric(),
stringsAsFactors = FALSE
)
# Loop through each species and perform Mantel test
for (species in species_list) {
print(paste("Processing species:", species))
# Filter data for the current species
species_data <- identity_data_clean %>% filter(virus_species1 == species)
# Create a list of all unique sequences in this species
seqs <- unique(c(species_data$seq1, species_data$seq2))
# Create all combinations of seq1 and seq2
all_combinations <- expand.grid(seq1 = seqs, seq2 = seqs, stringsAsFactors = FALSE)
# Merge with species_data to get sequence_identity and geographical_distance
# janky joining A-B pairs like this only to use distinct but wanted to ensure
# I wasn't missing values
sequence_identity_full <- all_combinations %>%
left_join(species_data %>% select(seq_min, seq_max, sequence_identity), by = c('seq1' = "seq_min", 'seq2' = "seq_max")) %>%
filter(seq1 != seq2) %>%
left_join(species_data %>% select(seq_min, seq_max, sequence_identity), by = c('seq2' = "seq_min", 'seq1' = "seq_max")) %>%
mutate(sequence_identity.x = case_when(is.na(sequence_identity.x) ~ as.character(.$sequence_identity.y),
TRUE ~ as.character(sequence_identity.x))) %>%
rename(sequence_identity = sequence_identity.x) %>%
select(-sequence_identity.y) %>%
mutate(seq = paste0(pmin(seq1, seq2), ";", pmax(seq1, seq2))) %>%
distinct(seq, .keep_all = TRUE) %>%
select(-seq)
geographical_distance_full <- all_combinations %>%
left_join(species_data %>% select(seq1, seq2, geographical_distance), by = c('seq1', 'seq2')) %>%
filter(seq1 != seq2) %>%
mutate(seq = paste0(pmin(seq1, seq2), ";", pmax(seq1, seq2))) %>%
distinct(seq, .keep_all = TRUE) %>%
select(-seq)
sequence_identity_matrix <- sequence_identity_full %>%
pivot_wider(names_from = seq2, values_from = sequence_identity) %>%
column_to_rownames("seq1") %>%
mutate(across(everything(), as.numeric)) %>%
as.matrix()
geographical_distance_matrix <- geographical_distance_full %>%
pivot_wider(names_from = seq2, values_from = geographical_distance) %>%
column_to_rownames("seq1") %>%
mutate(across(everything(), as.numeric)) %>%
as.matrix()
symmetrize_matrix <- function(mat, diag_value = NA) {
mat <- ifelse(is.na(mat), t(mat), mat)
diag(mat) <- diag_value
mat <- apply(mat, 2, as.numeric)
rownames(mat) <- colnames(mat)
return(mat)
}
sequence_identity_matrix <- symmetrize_matrix(sequence_identity_matrix, diag_value = 100)
geographical_distance_matrix <- symmetrize_matrix(geographical_distance_matrix, diag_value = 0)
# Check for NA because I am terrible at using matrices
if (any(is.na(sequence_identity_matrix)) || any(is.na(geographical_distance_matrix))) {
print(paste("Skipping species", species, "due to NAs in distance matrices"))
next  # Skip to next species
}
# Convert matrices to distance objects
sequence_identity_dist <- as.dist(100 - sequence_identity_matrix)
geographical_distance_dist <- as.dist(geographical_distance_matrix)
# Perform Mantel test
mantel_result <- mantel(sequence_identity_dist, geographical_distance_dist, method = "spearman", permutations = 999)
mantel_results <- rbind(mantel_results, data.frame(
species = species,
mantel_r = mantel_result$statistic,
mantel_p_value = mantel_result$signif
))
print(paste("Mantel test completed for", species, "R:", mantel_result$statistic, "p-value:", mantel_result$signif))
}
View(sequence_identity_full)
View(symmetrize_matrix)
View(identity_data_clean)
