left_join(species_data %>% select(seq1, seq2, sequence_identity), by = c('seq1', 'seq2'))
geographical_distance_full <- all_combinations %>%
left_join(species_data %>% select(seq1, seq2, geographical_distance), by = c('seq1', 'seq2'))
# Pivot wider to create matrices
