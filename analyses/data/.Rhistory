rownames(sequence_identity_matrix) <- seqs
geographical_distance_matrix <- apply(geographical_distance_matrix, 2, as.numeric)
rownames(geographical_distance_matrix) <- seqs
# Symmetrize the matrices by filling lower triangle
sequence_identity_matrix[lower.tri(sequence_identity_matrix)] <-
t(sequence_identity_matrix)[lower.tri(sequence_identity_matrix)]
geographical_distance_matrix[lower.tri(geographical_distance_matrix)] <-
t(geographical_distance_matrix)[lower.tri(geographical_distance_matrix)]
# Fill diagonal values
diag(sequence_identity_matrix) <- 100
diag(geographical_distance_matrix) <- 0
