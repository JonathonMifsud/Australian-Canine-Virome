# Supplementary Figure 1
plot_data <- identity_data_clean %>%
select(virus_species1, sequence_identity, geographical_distance) %>%
distinct()
themeGeneral1 <- theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
panel.border = element_rect(
colour = "black",
fill = NA,
size = 1
),
axis.ticks.length = unit(-1.5, "mm"),
axis.ticks = element_line(size = 1),
axis.line.x = element_line(),
axis.line.y = element_line(),
axis.title.x = element_text(
face = "bold",
size = 13,
margin = margin(5, 0, 0, 0),
family="Helvetica"
),
strip.text.x = element_text(size = 12),
axis.title.y = element_text(
face = "bold",
size = 13,
margin = margin(0, 5, 0, 0),
family="Helvetica"
),
axis.text.x = element_text(
face = "bold",
size = 11,
colour = "black",
margin = margin(5, 0, 0, 0, "pt"),
family="Helvetica"
),
axis.text.y = element_text(
face = "bold",
size = 11,
colour = "black",
margin = margin(0, 5, 0, 0, "pt"),
family="Helvetica"
),
panel.spacing.y = unit(1, "points")
)
combined_plot <- ggplot(plot_data, aes(x = geographical_distance, y = sequence_identity)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm", color = "red", se = FALSE, linetype = "dashed") +
facet_wrap(~ virus_species1, scales = "free") +
labs(
x = "Geographical Distance (km)",
y = "Sequence Identity (%)"
) +
theme_minimal()+
themeGeneral1
ggsave(plot = combined_plot, filename = "supplementary_figure1.svg", height = 8, width = 12, limitsize = FALSE, dpi = 1000)
combined_plot
ggsave(plot = combined_plot, filename = "supplementary_figure1.svg", height = 8, width = 12, limitsize = FALSE, dpi = 1000)
