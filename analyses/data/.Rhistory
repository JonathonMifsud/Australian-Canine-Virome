pivot_wider(names_from = seq2, values_from = sequence_identity) %>%
column_to_rownames("seq1") %>%
as.matrix()
geographical_distance_matrix <- geographical_distance_full %>%
pivot_wider(names_from = seq2, values_from = geographical_distance) %>%
column_to_rownames("seq1") %>%
as.matrix()
